# Stage 1: Build
FROM node:20-slim AS build

WORKDIR /app

# Копируем конфиги
COPY frontend/package*.json ./
RUN npm install

# Копируем остальной код фронтенда
COPY frontend/ ./

# Аргументы сборки (если нужно передать API URL)
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# Stage 2: Serve with Nginx
FROM nginx:alpine

# Копируем билд
COPY --from=build /app/dist /usr/share/nginx/html

# Копируем конфиг nginx (опционально, используем дефолтный)
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
